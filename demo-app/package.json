{
  "name": "AccessCheckoutReactNativeDemo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:sdk": "pnpm --filter @worldpay/access-worldpay-checkout-react-native-sdk run prepare",
    "test:sdk": "pnpm --filter @worldpay/access-worldpay-checkout-react-native-sdk run test",
    "lint:sdk": "pnpm --filter @worldpay/access-worldpay-checkout-react-native-sdk run lint",
    "e2e:build:ios": "detox build --configuration ios",
    "e2e:test:ios": "detox test --configuration ios",
    "e2e:ios": "pnpm run e2e:build:ios && pnpm run e2e:test:ios",
    "e2e:build:android": "detox build --configuration android",
    "e2e:test:android": "detox test --configuration android",
    "e2e:android": "pnpm run e2e:build:android && pnpm run e2e:test:android",
    "e2e:build:ios-ci": "detox build --configuration ios-ci",
    "e2e:test:ios-ci": "detox test --configuration ios-ci --cleanup",
    "e2e:ios-ci": "pnpm run e2e:build:ios-ci && pnpm run e2e:test:ios-ci",
    "e2e:build:android-ci": "detox build --configuration android-ci",
    "e2e:test:android-ci": "detox test --configuration android-ci --cleanup",
    "e2e:android-ci": "pnpm run e2e:build:android-ci && pnpm run e2e:test:android-ci"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.0",
    "@react-native/new-app-screen": "0.87.0",
    "react-native-safe-area-context": "^5.5.2",
    "@worldpay/access-worldpay-checkout-react-native-sdk": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "detox": "^20.45.1"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
